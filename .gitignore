# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
dist/
build/
.venv/
.ruff_cache/
.mypy_cache/
.pytest_cache/
.coverage
htmlcov/

# NOTE: .python-version is committed on purpose (pins the uv interpreter).

# --- Project artifacts ---
# v0.3's FAISS index; since 1.0 the index lives in Qdrant (DEC-19), and this folder is
# only ever a leftover to delete
vectorstore/
# paths.state: the writer lock, and later the job records (DEC-19, DEC-23)
var/
# scratch copies; never a source of truth
temp/
# data files no configured loader can read; kept on disk, never tracked
corpus/*.parquet
# datasets fetched by scripts/fetch_dataset.py (binary; outside corpus/ on purpose)
downloads/
# RAGAs run artifacts (Phase 2)
eval_output/
# a tier-2 run's checkpoint, until the run file it leads to is written (S2-5b)
*.partial.jsonl
# machine-specific overrides (SRS §8.3)
config.local.yaml
.env

# --- Backups, media ---
*.save
*.bak
*.orig
*.webm
*.mp4

# --- OS / editor litter ---
.DS_Store
Thumbs.db
*.swp
*.swo
*~
.idea/
