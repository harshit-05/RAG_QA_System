# The variables a host shell sets for rag_qa: names only, never a value.
# Copy this file to .env (gitignored), fill in what you use, and load it into the shell
# before a command:
#     set -a; . ./.env; set +a
# rag_qa reads the environment only, never this file or .env.

# The hosted fallback's API key (DEC-21, S3-6), used when pipeline.query.fallback_llm
# names an entry, whatever its provider.
RAG_FALLBACK_API_KEY=
